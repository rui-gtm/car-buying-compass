---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const SITE_NAME = "A Buyer's Account";
const TWITTER_HANDLE = "@buyersaccount";

const {
  title,
  description,
  ogType = "website",
  // Placeholder social-card image — swap for a real 1200×630 image at
  // public/og-image.jpg (or pass a page-specific `image` prop) before launch.
  image = "/og-image.jpg",
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const navigation = [
  { href: "/", label: "Story" },
  { href: "/reviews", label: "Reviews" },
  { href: "/guides", label: "Buying guide" },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="the author" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-50 -translate-y-24 bg-primary px-4 py-3 font-semibold text-primary-foreground transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-40 bg-background">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <a href="/" class="w-fit py-2 text-sm font-semibold text-foreground no-underline">
          A buyer's account
        </a>
        <nav aria-label="Primary navigation">
          <ul class="flex items-center gap-1">
            {
              navigation.map((item) => {
                const isActive =
                  pathname === item.href ||
                  (item.href !== "/" && pathname.startsWith(`${item.href}/`));
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive ? "page" : undefined}
                      class={`inline-flex min-h-11 items-center border-b-2 px-2 text-sm font-medium no-underline transition-colors sm:px-3 ${
                        isActive
                          ? "border-primary text-primary"
                          : "border-transparent text-muted-foreground hover:border-border hover:text-foreground"
                      }`}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="border-t border-white/15 bg-foreground text-background">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 sm:px-6">
        <div>
          <p class="text-sm font-semibold text-background">Contact</p>
          <a
            class="mt-2 inline-flex min-h-11 items-center text-background underline underline-offset-4"
            href="mailto:author@example.com"
          >
            author@example.com
          </a>
        </div>
        <p class="max-w-none text-sm leading-6 text-background/70 sm:justify-self-end">
          Disclosure: this is a customer account of one purchase, including our recollections of
          conversations. The dispute awaits an NCAT hearing. McCarroll's has not yet been invited
          to respond specifically to this article.
        </p>
      </div>
    </footer>
  </body>
</html>
