---
import "../styles/global.css";
import {
  AUTHOR_NAME,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  SITE_NAME,
  authorEntity,
  websiteEntity,
} from "../lib/site";

interface Props {
  /** The full <title>; pages build it with pageTitle() from lib/site. */
  title: string;
  description: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph in <head>. */
  schema?: Record<string, unknown>[];
  /** Keeps the page out of search results and drops its canonical (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = "website",
  // Pass a page-specific `image` (e.g. a post's hero photo) to override the
  // site-wide social card.
  image = DEFAULT_OG_IMAGE,
  imageAlt = DEFAULT_OG_IMAGE_ALT,
  publishedTime,
  modifiedTime,
  schema = [],
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [websiteEntity, authorEntity, ...schema],
};

const navigation = [
  { href: "/", label: "My story" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
] as const;

// trailingSlash is "always", so every path ends in "/". The home link only
// matches exactly; the others also cover their child pages.
const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large" />
          <link rel="canonical" href={canonicalURL} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      !noindex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-50 -translate-y-24 bg-primary px-4 py-3 font-semibold text-primary-foreground transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-40 bg-background">
      <div
        class="mx-auto flex max-w-6xl flex-row items-center justify-between gap-2 px-4 py-4 sm:px-6"
      >
        <a
          href="/"
          class="w-fit max-w-[8rem] truncate py-2 text-sm font-semibold text-foreground no-underline sm:max-w-none"
        >
          {SITE_NAME}
        </a>
        <nav aria-label="Primary navigation">
          <ul class="flex items-center gap-0.5 sm:gap-1">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class={`inline-flex min-h-11 items-center whitespace-nowrap border-b-2 px-1.5 text-sm font-medium no-underline transition-colors sm:px-3 ${
                      isActive(item.href)
                        ? "border-primary text-primary"
                        : "border-transparent text-muted-foreground hover:border-border hover:text-foreground"
                    }`}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="border-t border-white/15 bg-foreground text-background">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 sm:px-6">
        <div>
          <p class="text-sm font-semibold text-background">{SITE_NAME}</p>
          <p class="mt-2 max-w-none text-sm leading-6 text-background/70">
            Written by the buyer, from first-hand experience of one purchase in Sydney. Not
            affiliated with McCarroll's or GWM. No advertising, sponsorship or affiliate links.
          </p>
        </div>
        <p class="max-w-none text-sm leading-6 text-background/70 sm:justify-self-end">
          Disclosure: this is a customer account of one purchase, including our recollections of
          conversations. The dispute awaits an NCAT hearing. McCarroll's has not yet been invited
          to respond specifically to this article.
        </p>
      </div>
    </footer>
  </body>
</html>
