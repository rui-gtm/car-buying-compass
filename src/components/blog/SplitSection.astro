---
// A left-right (image + text) block for blog content, e.g. an exterior shot
// next to a paragraph of commentary. Set `reverse` to put the image on the
// right instead. Import the photo at the top of the .mdx file:
//
//   import cockpit from "../../assets/photos/jolion-vanta-cockpit-2026-06.jpg";
//   <SplitSection image={cockpit} imageAlt="…" caption="…" takenOn="2026-06">
//
// Until a photo is passed, a "PHOTO — to be added" placeholder holds its
// place. `imageAlt` is required either way so the description is ready when
// the photo arrives.
import type { ImageMetadata } from "astro";
import Photo from "../Photo.astro";

interface Props {
  image?: ImageMetadata;
  imageAlt: string;
  caption?: string;
  takenOn?: string;
  reverse?: boolean;
}

const { image, imageAlt, caption, takenOn, reverse = false } = Astro.props;
---

<div class="mt-10 grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
  <div class:list={[reverse ? "lg:order-2" : "lg:order-1"]}>
    {
      image ? (
        <Photo
          src={image}
          alt={imageAlt}
          caption={caption}
          takenOn={takenOn}
          sizes="(min-width: 64rem) 36rem, 100vw"
        />
      ) : (
        <div class="exhibit-photo">
          <span class="font-mono text-xs leading-relaxed tracking-wide text-muted-foreground">
            PHOTO — to be added
          </span>
        </div>
      )
    }
  </div>
  <div class:list={["[&>p+p]:mt-4", reverse ? "lg:order-1" : "lg:order-2"]}>
    <slot />
  </div>
</div>
