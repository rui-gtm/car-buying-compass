---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section aria-labelledby="related-heading" class="mt-16">
      <p class="section-marker">Keep reading</p>
      <h2 id="related-heading" class="text-2xl font-bold text-foreground">
        Related Jolion topics
      </h2>
      <div class="mt-6 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )
}
