---
import type { CollectionEntry } from "astro:content";
import Photo from "../Photo.astro";

interface Props {
  post: CollectionEntry<"blog">;
  /** "h2" on the /blog/ listing (directly under the page H1); "h3" where the
   *  cards sit under their own H2, e.g. "Related reviews". */
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const { title, description, category, heroImage, heroImageAlt, author, publishDate } = post.data;
const formattedDate = new Intl.DateTimeFormat("en-AU", { dateStyle: "medium" }).format(publishDate);
const href = `/blog/${post.id}/`;
---

<!-- The title link is stretched over the whole card so image and text are
     one click target, without nesting interactive elements. -->
<article class="group relative flex flex-col">
  {
    heroImage ? (
      <Photo
        src={heroImage}
        alt={heroImageAlt}
        sizes="(min-width: 64rem) 23rem, (min-width: 40rem) 50vw, 100vw"
        class="mb-5"
        imgClass="aspect-video w-full border border-border object-cover"
      />
    ) : (
      <div class="exhibit-photo mb-5 aspect-video min-h-0!">
        <span class="font-mono text-xs tracking-wide text-muted-foreground">PHOTO — to be added</span>
      </div>
    )
  }
  <p class="text-xs uppercase tracking-[0.12em] text-muted-foreground">{category}</p>
  <Heading class="mt-2 text-xl font-bold leading-snug text-foreground">
    <a href={href} class="no-underline after:absolute after:inset-0 group-hover:text-primary">
      {title}
    </a>
  </Heading>
  <p class="mt-3 line-clamp-2 text-muted-foreground">{description}</p>
  <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted-foreground">
    <span class="inline-flex items-center gap-1.5">
      <svg
        aria-hidden="true"
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"
        ></circle></svg
      >
      <span class="sr-only">Author:</span>{author}
    </span>
    <span class="inline-flex items-center gap-1.5">
      <svg
        aria-hidden="true"
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"
        ></rect><path d="M3 10h18"></path></svg
      >
      <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    </span>
  </p>
</article>
