---
// One photo as a <figure>: responsive AVIF/WebP via <Picture>, required alt
// text, and an optional caption with the date it was taken. Dated captions
// matter here — the photos are evidence, and readers and search engines both
// weigh first-hand, dated images.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { formatPhotoDate } from "../lib/images";

interface Props {
  src: ImageMetadata;
  /** Describe what the photo shows, specifically (e.g. which panel, what damage). */
  alt: string;
  caption?: string;
  /** When the photo was taken: "YYYY-MM" or "YYYY-MM-DD". */
  takenOn?: string;
  /** "eager" only for a photo at the top of the page. */
  loading?: "lazy" | "eager";
  /** How wide the image renders, for choosing the right file size. */
  sizes?: string;
  class?: string;
  imgClass?: string;
}

const {
  src,
  alt,
  caption,
  takenOn,
  loading = "lazy",
  sizes = "(min-width: 72rem) 72rem, 100vw",
  class: className,
  imgClass = "w-full border border-border",
} = Astro.props;

// Never upscale: only offer widths up to the original's.
const widths = [480, 800, 1200, 1600].filter((width) => width < src.width).concat(src.width);
---

<figure class={className}>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    class={imgClass}
  />
  {
    (caption || takenOn) && (
      <figcaption class="mt-2 text-sm leading-6 text-muted-foreground">
        {caption}
        {takenOn && (
          <>
            {caption && " "}
            <span class="whitespace-nowrap">
              (photographed <time datetime={takenOn}>{formatPhotoDate(takenOn)}</time>)
            </span>
          </>
        )}
      </figcaption>
    )
  }
</figure>
