---
import BaseLayout from "../layouts/BaseLayout.astro";

const vehicles = [
  {
    name: "Toyota Corolla",
    year: "2023",
    variant: "Ascent Sport Hybrid hatch",
    verdict:
      "Efficient and easy to live with, but rear-seat and boot space require a careful family test.",
    body: "In mixed suburban driving, the hybrid system made low-speed progress quiet and economical. The controls were straightforward and the standard safety equipment was easy to understand rather than buried in menus.",
    detail:
      "The trade-off is packaging. A rear-facing child seat can noticeably reduce front-passenger space, and the hybrid battery arrangement limits the flexibility some hatch buyers expect. Take the people and luggage you actually carry to the test drive.",
  },
  {
    name: "Mazda CX-30",
    year: "2024",
    variant: "G25 Touring AWD",
    verdict:
      "A polished small SUV with an excellent cabin, offset by modest rear visibility and space.",
    body: "The steering, seating position and conventional automatic make the CX-30 feel settled in city traffic and on faster roads. Materials are unusually good for the class, and the rotary controller is less distracting than a touchscreen once learnt.",
    detail:
      "The sloping body shape compromises the rear quarter view and makes the back seat feel tighter than the exterior dimensions suggest. The larger engine is responsive, although buyers prioritising fuel use should compare it carefully with hybrid alternatives.",
  },
  {
    name: "Kia Sportage",
    year: "2024",
    variant: "SX+ 1.6T AWD",
    verdict:
      "A practical, well-equipped family SUV whose busy low-speed ride deserves an extended test drive.",
    body: "The broad rear seat, useful boot opening and clear surround-view cameras suit daily family use. Performance is adequate for overtaking, and the warranty provides useful reassurance for buyers planning to keep the car.",
    detail:
      "On patchy suburban roads the ride can feel more restless than expected, particularly on larger wheels. Some climate and media functions share the same control strip, so try common adjustments while driving rather than judging the cabin at rest.",
  },
];

const assessment = [
  {
    stage: "Delivery",
    anchor: "collection",
    rating: "Poor",
    text: "The car arrived with two dents, a scratch above the driver's door handle and a paint stain on the bonnet. The damage was visible immediately and reported on the spot.",
  },
  {
    stage: "First repair",
    anchor: "dents-fixed",
    rating: "Adequate",
    text: "The dents and bonnet stain were fixed within about three days. The driver's door scratch was not resolved, and no explanation was given at the time about what further work it might need.",
  },
  {
    stage: "Second repair",
    anchor: "second-collection",
    rating: "Poor",
    text: "The car went back for another three days and was returned with the scratch still visible. To us, the touch-up paint applied looked worse than before.",
  },
  {
    stage: "Communication",
    anchor: "two-attempts",
    rating: "Poor",
    text: "A sales manager offered two services instead of repairing the door, then said it needed repainting — an explanation we hadn't heard before, despite two repair visits and repeated assurances that the damage was fixed.",
  },
  {
    stage: "Complaint handling",
    anchor: "ncat-offer",
    rating: "Poor",
    text: "McCarroll's offer to repaint the door and provide three services only followed notice of an NCAT claim. The offer has not resolved the dispute, and a hearing is yet to be scheduled.",
  },
];
---

<BaseLayout
  title="Independent Vehicle Reviews | A Buyer's Account"
  description="Practical Australian-market vehicle reviews and a separate stage-by-stage dealership assessment by the author."
>
  <main id="main-content">
    <article class="mx-auto max-w-6xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
      <header class="max-w-reading">
        <p class="eyebrow">Independent assessment</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-foreground sm:text-5xl">
          Vehicle reviews, kept separate from the dealership
        </h1>
        <p class="mt-6 text-xl leading-8 text-muted-foreground">
          The cars are assessed on their own merits. The company's conduct is evaluated separately,
          stage by stage.
        </p>
      </header>

      <section aria-labelledby="vehicle-reviews" class="mt-20">
        <div class="max-w-reading">
          <p class="eyebrow">Section A</p>
          <h2 id="vehicle-reviews" class="mt-3 text-3xl font-bold text-foreground">
            Vehicle reviews
          </h2>
          <p class="mt-4 text-muted-foreground">
            Independent Australian-market observations by the author, based on test drives and
            everyday use.
          </p>
          <p class="mt-5">
            <a href="/#collection" class="editorial-link"
              >See the condition the car was in at collection</a
            >.
          </p>
        </div>
        <div class="mt-10 grid gap-6">
          {
            vehicles.map((vehicle, index) => (
              <article class="editorial-card">
                <p class="section-marker">Vehicle {String(index + 1).padStart(2, "0")}</p>
                <p class="mt-2 text-sm font-semibold text-primary">
                  {vehicle.year} · {vehicle.variant}
                </p>
                <h3 class="mt-2 text-2xl font-bold text-foreground">{vehicle.name}</h3>
                <p class="mt-4 font-semibold leading-7 text-foreground">{vehicle.verdict}</p>
                <p class="mt-4 text-muted-foreground">{vehicle.body}</p>
                <details class="editorial-details mt-5">
                  <summary>Practical considerations</summary>
                  <p>{vehicle.detail}</p>
                </details>
              </article>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="dealership-assessment" class="mt-24">
        <div class="max-w-reading">
          <p class="eyebrow">Section B</p>
          <h2 id="dealership-assessment" class="mt-3 text-3xl font-bold text-foreground">
            Dealership assessment: McCarroll's GWM Artarmon
          </h2>
          <p class="mt-4 text-muted-foreground">
            This assessment concerns the author's transaction and complaint. It is not a rating of
            the vehicles reviewed above.
          </p>
          <p class="mt-5">
            <a href="/" class="editorial-link"
              >Read the full chronological account of what occurred</a
            >.
          </p>
        </div>
        <div class="mt-10 grid gap-4">
          {
            assessment.map((item, index) => (
              <article class="assessment-block grid gap-3 md:grid-cols-[3rem_12rem_8rem_1fr] md:items-center md:gap-6">
                <p class="section-marker mb-0!">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="text-lg font-bold text-foreground">
                  <a href={`/#${item.anchor}`} class="no-underline hover:text-primary">
                    {item.stage}
                  </a>
                </h3>
                <p class="font-semibold text-primary">{item.rating}</p>
                <p class="max-w-reading text-muted-foreground">{item.text}</p>
              </article>
            ))
          }
        </div>
      </section>
    </article>

    <nav aria-label="Continue reading" class="onward-links">
      <p class="eyebrow">Continue reading</p>
      <div class="mt-5 flex flex-col items-start gap-4">
        <a href="/" class="editorial-link">Follow the purchase from order to unresolved complaint</a
        >
        <a href="/guides" class="editorial-link">Use the pre-deposit and delivery checklists</a>
      </div>
    </nav>
  </main>
</BaseLayout>
