---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

// Lower-cased text each card is matched against by the hero search box.
const searchText = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.topic, ...post.data.tags]
    .join(" ")
    .toLowerCase();
---

<BaseLayout
  title="Independent Vehicle Reviews | My McCarroll's Account"
  description="Practical Australian-market vehicle reviews and a stage-by-stage dealership assessment by the author, all searchable in one place."
>
  <main id="main-content">
    <article class="mx-auto max-w-6xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
      <header class="max-w-reading">
        <p class="eyebrow">Independent assessment</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-foreground sm:text-5xl">
          Vehicle reviews, kept separate from the dealership
        </h1>
        <p class="mt-6 text-xl leading-8 text-muted-foreground">
          Owner reviews, buying guides and a stage-by-stage dealership assessment, based on test
          drives and everyday use in Australia.
        </p>
        <form role="search" class="mt-8" action="/reviews" method="get">
          <label for="review-search" class="sr-only">Search reviews</label>
          <input
            id="review-search"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search reviews, e.g. safety, price, dealership"
            class="h-12 w-full border border-input bg-background px-4 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus-visible:outline-none"
          />
        </form>
        <p id="review-search-status" class="sr-only" aria-live="polite"></p>
      </header>

      {
        posts.length > 0 ? (
          <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <div data-review-card data-search={searchText(post)} class="grid">
                <PostCard post={post} />
              </div>
            ))}
          </div>
        ) : (
          <p class="mt-14 text-muted-foreground">
            The first reviews are on their way — check back soon.
          </p>
        )
      }
      <p id="review-search-empty" class="mt-14 text-muted-foreground" hidden>
        No reviews match that search. Try a broader term, such as "Jolion" or "price".
      </p>
    </article>

    <nav aria-label="Continue reading" class="onward-links">
      <p class="eyebrow">Continue reading</p>
      <div class="mt-5 flex flex-col items-start gap-4">
        <a href="/" class="editorial-link">Follow the purchase from order to unresolved complaint</a
        >
        <a href="/guides" class="editorial-link">Use the pre-deposit and delivery checklists</a>
      </div>
    </nav>
  </main>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#review-search");
  const status = document.querySelector<HTMLElement>("#review-search-status");
  const empty = document.querySelector<HTMLElement>("#review-search-empty");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-review-card]")];

  // Every word typed must appear somewhere in the card's title, description,
  // topic or tags. The query is mirrored to ?q= so filtered views can be shared.
  function applySearch(query: string) {
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const card of cards) {
      const text = card.dataset.search ?? "";
      const match = terms.every((term) => text.includes(term));
      card.hidden = !match;
      if (match) visible++;
    }
    if (status) status.textContent = terms.length ? `${visible} of ${cards.length} match` : "";
    if (empty) empty.hidden = visible > 0 || cards.length === 0;

    const url = new URL(window.location.href);
    if (query.trim()) url.searchParams.set("q", query.trim());
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  if (input) {
    input.value = new URLSearchParams(window.location.search).get("q") ?? "";
    applySearch(input.value);
    input.addEventListener("input", () => applySearch(input.value));
    input.form?.addEventListener("submit", (event) => {
      event.preventDefault();
      applySearch(input.value);
    });
  }
</script>
