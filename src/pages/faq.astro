---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR_NAME, FAQ_MODIFIED, SITE_URL, breadcrumbList, ids, pageTitle } from "../lib/site";

// Official sources cited under the answers. Check the links still resolve
// whenever the page is updated.
const sources = {
  accc: {
    label: "ACCC: New and second-hand cars",
    href: "https://www.accc.gov.au/consumers/health-home-car/motor-cars",
  },
  fairTrading: {
    label: "NSW Fair Trading: Buying new and used cars complaints",
    href: "https://www.nsw.gov.au/departments-and-agencies/fair-trading/complaints-and-enquiries/automotive/buying-new-and-used-cars-and-motorcycles-complaints-and-enquiries",
  },
  ncat: {
    label: "NCAT: Motor vehicle disputes",
    href: "https://ncat.nsw.gov.au/case-types/consumers-and-businesses/motor-vehicles.html",
  },
};

interface FaqEntry {
  id: string;
  question: string;
  answer: string;
  detail: string;
  note: string;
  storyId: string;
  sources?: { label: string; href: string }[];
}

const faqs: FaqEntry[] = [
  {
    id: "before-deposit",
    question: "What should I check before paying a car deposit?",
    answer:
      "Before paying a deposit, confirm the exact vehicle, drive-away price, refund conditions and delivery estimate in writing.",
    detail:
      "Record the model year, variant, engine or powertrain, colour, options and whether the car is new, demonstrator or used. Ask whether the deposit is refundable, what event allows either party to cancel, and whether the quoted delivery date is an estimate or a commitment. Do not rely on a brochure or spoken assurance where a feature matters to your decision.",
    note: "In my case, the dispute began at delivery, not before it. See what to inspect when the car arrives.",
    storyId: "collection",
  },
  {
    id: "contract-wording",
    question: "What should a car purchase contract say?",
    answer:
      "The contract should identify the precise car, total price, included features, agreed conditions and any promises that affected your decision.",
    detail:
      "Read every field before signing and strike out blank spaces where appropriate. If finance approval, an independent inspection, a trade-in value or a delivery deadline matters, ask for it to be written as a condition. Keep the version you signed and compare it with the dealer's final copy before leaving.",
    note: "In my case, no repair was ever put in writing, only verbal assurances that the damage was fixed.",
    storyId: "dents-fixed",
  },
  {
    id: "delivery-inspection",
    question: "What should I inspect when collecting a new car?",
    answer:
      "At delivery, inspect the car in good light and verify its identity, condition, specification, accessories and documents before accepting it.",
    detail:
      "Check the VIN against the contract and registration paperwork. Test the keys, lights, cameras, infotainment, charging cable where relevant, spare wheel or repair kit, and every option you paid for. Photograph the vehicle and odometer. If something is wrong, write it on the handover record before driving away and ask what will happen next.",
    note: "I found two dents, a scratch and a paint stain at collection, before driving away.",
    storyId: "collection",
  },
  {
    id: "repair-scope-writing",
    question: "What should I get in writing before a repair, and before a second visit?",
    answer:
      "Before the car goes back for any repair, ask the dealership to confirm the scope of work in writing, including whether a panel will be repainted rather than touched up.",
    detail:
      "A touch-up and a repaint are different jobs with different outcomes for a panel's finish and resale value. Ask what assessment was done, what work is planned, and get that scope confirmed in writing before booking the visit, not just a verbal assurance that 'it will be fixed'. If the plan changes between visits, ask why and get the revised scope in writing too.",
    note: "I learned repainting was needed only after two repair visits and repeated assurances that the scratch was fixed.",
    storyId: "two-attempts",
  },
  {
    id: "not-as-described",
    question: "What are my rights if a new car is damaged or not as described in Australia?",
    answer:
      "Under the consumer guarantees in the Australian Consumer Law, a car sold by a dealer must match its description and be of acceptable quality, which includes being acceptable in appearance and finish.",
    detail:
      "If a car fails a consumer guarantee, you can ask the dealer for a remedy, which may be a repair, replacement or refund. Which one depends on the facts, including whether the failure is major and whether it can be fixed within a reasonable time. Consumer guarantees operate separately from a manufacturer warranty. In NSW, NSW Fair Trading can explain your options; for advice about your own circumstances, obtain independent legal advice.",
    note: "My unresolved question is whether a repaired and repainted door reduces the car's resale value, and what that's worth.",
    storyId: "why-declined",
    sources: [sources.accc],
  },
  {
    id: "escalate-complaint",
    question: "How do I complain about a car dealer in NSW?",
    answer:
      "Put the complaint to the dealer in writing first, stating the outcome you seek and a response date. If it stays unresolved, you can lodge a complaint with NSW Fair Trading and apply to the NSW Civil and Administrative Tribunal (NCAT).",
    detail:
      "Begin with the dealership's sales or service contact, then ask for the dealer principal or complaints manager. Keep the message concise: chronology, evidence, problem, requested remedy and response date. NSW Fair Trading's vehicle complaint form asks for the vehicle details and documents such as quotes, reports and invoices. NCAT's Consumer and Commercial Division hears motor vehicle disputes, including faulty new cars and unsatisfactory repairs; for a motor vehicle consumer claim you must apply within three years of when the problem began. Outside NSW, contact your state or territory consumer affairs body.",
    note: "I raised NCAT after two failed repairs and ongoing email follow-up produced no resolution.",
    storyId: "ncat-offer",
    sources: [sources.fairTrading, sources.ncat],
  },
  {
    id: "document-records",
    question: "What records should I keep when buying a car?",
    answer:
      "Keep every version of the advertisement, quote, contract, invoice, payment record and message, plus dated notes of conversations.",
    detail:
      "Save screenshots as files rather than relying on a listing remaining online. After an important call, email a short summary beginning with 'My understanding of our conversation is…' and invite corrections. Keep photographs from inspection and delivery, the VIN, odometer reading, names or job titles of contacts, and a simple chronology of promised and actual response dates.",
    note: "Text messages and emails became my record once verbal assurances that the scratch was fixed proved wrong twice.",
    storyId: "second-collection",
  },
];

// Questions are shown in these groups, in this order, each as a closed
// accordion item.
const groups = [
  {
    title: "Before you sign",
    ids: ["before-deposit", "contract-wording"],
  },
  {
    title: "Collection and repairs",
    ids: ["delivery-inspection", "repair-scope-writing"],
  },
  {
    title: "Your rights and complaints",
    ids: ["not-as-described", "escalate-complaint", "document-records"],
  },
].map((group) => ({
  ...group,
  items: group.ids.map((id) => faqs.find((faq) => faq.id === id)!),
}));

const title = "Buying a New Car in NSW: Delivery Checks, Rights & NCAT";
const description =
  "What I learned buying a new car in NSW: deposits, contracts, delivery checks, Australian Consumer Law rights, NSW Fair Trading complaints and NCAT.";

const schema = [
  {
    "@type": "FAQPage",
    "@id": `${SITE_URL}/faq/#page`,
    url: `${SITE_URL}/faq/`,
    name: title,
    inLanguage: "en-AU",
    dateModified: FAQ_MODIFIED,
    author: { "@id": ids.author },
    isPartOf: { "@id": ids.website },
    mainEntity: faqs.map(({ question, answer, detail }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: `${answer} ${detail}` },
    })),
  },
  breadcrumbList([
    { name: "Home", path: "/" },
    { name: "FAQ", path: "/faq/" },
  ]),
];
---

<BaseLayout
  title={pageTitle(title)}
  description={description}
  schema={schema}
>
  <main id="main-content">
    <header class="mx-auto max-w-6xl px-4 pb-14 pt-16 sm:px-6 sm:pb-16 sm:pt-24">
      <p class="eyebrow">NSW car buying FAQ</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight text-foreground sm:text-5xl">
        Buying a new car in NSW: questions to answer before you sign or collect
      </h1>
      <p class="mt-6 max-w-reading text-xl leading-8 text-muted-foreground">
        What I learned buying a new car in Sydney: direct answers to the checks worth making before
        money or keys change hands, each linked to what happened in my own purchase.
      </p>
      <p class="mt-5 text-sm text-muted-foreground">
        By {AUTHOR_NAME}<span aria-hidden="true"> · </span>Last updated{" "}
        <time datetime={FAQ_MODIFIED}>
          {new Intl.DateTimeFormat("en-AU", { dateStyle: "long" }).format(new Date(FAQ_MODIFIED))}
        </time>
      </p>
    </header>

    <!-- Answers sit inside native <details>, so they are in the HTML (and the
         FAQPage data below) even while collapsed, and open without JavaScript. -->
    <div class="bg-secondary/60 px-4 py-14 sm:px-6 sm:py-16">
      <div class="mx-auto grid max-w-3xl gap-14">
        {
          groups.map((group) => (
            <section aria-labelledby={`group-${group.ids[0]}`}>
              <h2 id={`group-${group.ids[0]}`} class="section-marker font-semibold">
                {group.title}
              </h2>
              <div class="border-b border-border">
                {group.items.map((faq) => (
                  <details id={faq.id} class="group border-t border-border first:border-t-0">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 [&::-webkit-details-marker]:hidden">
                      <h3 class="text-lg font-semibold leading-snug text-foreground group-hover:text-primary">
                        {faq.question}
                      </h3>
                      <svg
                        aria-hidden="true"
                        class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </summary>
                    <div class="pb-6 pr-10">
                      <p class="font-semibold leading-7 text-foreground">{faq.answer}</p>
                      <p class="mt-3 leading-7 text-muted-foreground">{faq.detail}</p>
                      {faq.sources && (
                        <p class="mt-3 text-sm leading-6 text-muted-foreground">
                          Official source{faq.sources.length > 1 ? "s" : ""}:{" "}
                          {faq.sources.map((source, index) => (
                            <>
                              {index > 0 && "; "}
                              <a href={source.href} class="editorial-link" rel="noopener">
                                {source.label}
                              </a>
                            </>
                          ))}
                        </p>
                      )}
                      <aside class="mt-5 border-l-2 border-primary bg-background px-4 py-3">
                        <p class="eyebrow">Why this matters</p>
                        <p class="mt-1.5 text-sm leading-6 text-foreground">{faq.note}</p>
                        <a
                          href={`/#${faq.storyId}`}
                          class="editorial-link mt-2 inline-block text-sm"
                        >
                          Read this part of my story →
                        </a>
                      </aside>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <nav aria-label="Continue reading" class="onward-links mt-0!">
      <p class="eyebrow">Continue reading</p>
      <div class="mt-5 flex flex-col items-start gap-4">
        <a href="/" class="editorial-link"
          >See how the checks apply in my full account</a
        >
        <a href="/blog/" class="editorial-link">Read my Haval Jolion owner reviews</a>
        <a href="/blog/mccarrolls-gwm-artarmon-dealership-assessment/" class="editorial-link"
          >Read the stage-by-stage dealership assessment</a
        >
      </div>
    </nav>
  </main>

  <script>
    // Links such as /faq/#delivery-inspection from the story page should land
    // on that question already expanded.
    function openFromHash() {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const target = id ? document.getElementById(id) : null;
      if (target instanceof HTMLDetailsElement) {
        target.open = true;
        target.scrollIntoView();
      }
    }
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  </script>
</BaseLayout>
