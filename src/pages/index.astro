---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import EvidencePhotos from "../components/EvidencePhotos.astro";
import { CURRENT_STATUS, evidencePhotos, quickAnswers } from "../lib/story";
import { defaultImageObject, imageObject } from "../lib/images";
import {
  AUTHOR_NAME,
  SITE_URL,
  STORY_MODIFIED,
  STORY_PUBLISHED,
  authorities,
  carEntity,
  dealerEntity,
  ids,
} from "../lib/site";

const title = "McCarroll's GWM Artarmon: My New Haval Arrived Damaged";
const description =
  "My first-hand account of buying a new 2026 Haval Jolion Vanta from McCarroll's GWM Artarmon, Sydney: damage at collection, two repair visits and an NCAT dispute.";
const headline = "My car-buying experience with McCarroll's GWM Artarmon";

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat("en-AU", { dateStyle: "long" }).format(new Date(iso));

// The social card, plus any evidence photos that have been added.
const schemaImages = [
  defaultImageObject,
  ...(await Promise.all(
    evidencePhotos.flatMap((photo) => (photo.src ? [imageObject(photo.src, photo.caption)] : [])),
  )),
];

const schema = [
  {
    "@type": "Article",
    "@id": `${SITE_URL}/#article`,
    headline,
    description,
    image: schemaImages,
    datePublished: STORY_PUBLISHED,
    dateModified: STORY_MODIFIED,
    inLanguage: "en-AU",
    author: { "@id": ids.author },
    publisher: { "@id": ids.author },
    isPartOf: { "@id": ids.website },
    mainEntityOfPage: `${SITE_URL}/`,
    about: [dealerEntity, carEntity],
    mentions: [authorities.ncat],
    contentLocation: { "@type": "Place", name: "Artarmon, Sydney, NSW, Australia" },
  },
];

interface TimelineItem {
  id: string;
  /** Machine-readable date for <time>; omitted where the date is approximate. */
  datetime?: string;
  date: string;
  location: string;
  title: string;
  text: string;
}

const timeline: TimelineItem[] = [
  {
    id: "tl-collection",
    datetime: "2026-05",
    date: "May 2026",
    location: "McCarroll's GWM, Artarmon",
    title: "The car arrives with damage",
    text: "I collected my first car, a brand-new 2026 Haval Jolion Vanta. At collection, we found two dents on the rear passenger door, a deep scratch above the driver's door handle and a paint stain on the bonnet. Protective wrapping was also trapped between a door's rubber seal and frame. We reported the problems immediately.",
  },
  {
    id: "tl-repair-one",
    datetime: "2026-06",
    date: "June 2026",
    location: "McCarroll's GWM, Artarmon",
    title: "First repair: two fixes, one left",
    text: "The dealership kept the car for around three days. The two dents and the bonnet stain were successfully removed. The driver's door scratch remained, so we raised it again.",
  },
  {
    id: "tl-repair-two",
    datetime: "2026-06",
    date: "June 2026, roughly two weeks later",
    location: "McCarroll's GWM, Artarmon",
    title: "Second repair, same assurance",
    text: "The car went back for another three days. Before collecting it, we contacted the dealership to check the work was complete and were assured, once again, that the damage had been fixed.",
  },
  {
    id: "tl-second-collection",
    datetime: "2026-06",
    date: "June 2026",
    location: "McCarroll's GWM, Artarmon",
    title: "“Fixed”—until we saw the car",
    text: "The scratch still had not been properly repaired. Touch-up paint appeared to have been applied, but to us the finish looked worse than before. A sales manager offered two services, valued at roughly $400–$500, instead of further repairing the door.",
  },
  {
    id: "tl-manager-response",
    datetime: "2026-06",
    date: "June 2026",
    location: "McCarroll's GWM, Artarmon",
    title: "“I'm not going to paint this”",
    text: "The manager explained that a proper repair would need the driver's door removed and repainted, as we recall it, without looking at the damaged area during the conversation. He said words to that effect, then walked away.",
  },
  {
    id: "tl-ncat-notice",
    date: "Mid-2026",
    location: "By email and text",
    title: "We raised NCAT",
    text: "We kept pursuing the issue by email and text. After we said we intended to take the matter to the NSW Civil and Administrative Tribunal, the dealership's position changed.",
  },
  {
    id: "tl-new-offer",
    date: "Mid-2026",
    location: "By email",
    title: "A new offer, after the fact",
    text: "McCarroll's offered to repaint the driver's door and provide three services, and named a panel shop it said had experience with European vehicles. By then, two unsuccessful repairs had already cost our confidence in the process.",
  },
  {
    id: "tl-current",
    datetime: "2026-09-25",
    date: "25 September 2026",
    location: "Ongoing",
    title: "Unresolved, awaiting a hearing",
    text: "The driver's door scratch has not been satisfactorily repaired. Some protective wrapping remains trapped. The dealership's latest offer remains repainting the door plus three services, and an NCAT hearing is yet to be scheduled.",
  },
];

// The case at a glance, shown as a progress tracker beside the hero. Keep it
// in step with the timeline above and CURRENT_STATUS in lib/story.ts.
const caseSteps: { when: string; title: string; note: string; pending?: boolean }[] = [
  { when: "May 2026", title: "Car collected", note: "Two dents, a deep scratch and a paint stain found on the day" },
  { when: "June 2026", title: "First repair · ~3 days", note: "Dents and stain fixed; the scratch remained" },
  { when: "June 2026", title: "Second repair · ~3 days", note: "Touch-up applied; the scratch still visible" },
  { when: "Mid-2026", title: "NCAT raised", note: "Offer changed to a repaint plus three services" },
  { when: "Next", title: "NCAT hearing", note: "Not yet scheduled", pending: true },
];

const toc = [
  { href: "#quick-answers", label: "Quick answers" },
  { href: "#collection", label: "Collection day" },
  { href: "#dents-fixed", label: "The dents were fixed. The scratch wasn't." },
  { href: "#second-collection", label: "“Fixed”—until we saw the car" },
  { href: "#two-attempts", label: "Why did it take two attempts to explain the repair?" },
  { href: "#ncat-offer", label: "After we raised NCAT, the offer changed" },
  { href: "#why-declined", label: "Why we didn't accept repainting and three services" },
  { href: "#timeline-heading", label: "The timeline" },
  { href: "#dispute-status", label: "Where the dispute stands" },
  { href: "#differently", label: "A first car shouldn't start like this" },
  { href: "#fair-outcome", label: "What do you think is a fair outcome?" },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={STORY_PUBLISHED}
  modifiedTime={STORY_MODIFIED}
  schema={schema}
>
  <main id="main-content">
    <article>
      <header class="hero-band">
        <div
          class="pb-section mx-auto grid max-w-6xl gap-10 px-4 pt-10 sm:px-6 sm:pt-14 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start lg:gap-14 lg:pt-20"
        >
          <div class="min-w-0">
            <p class="status-pill">
              <span class="status-dot" aria-hidden="true"></span>
              Unresolved · NCAT hearing pending
            </p>
            <h1 class="hero-title mt-6">{headline}</h1>
            <p class="hero-hook mt-6">
              Two visits. Around six days back at the dealership. Repeated assurances that the
              damage was fixed. Yet the scratch on my brand-new Haval remained, and the dispute is
              now heading to an NCAT hearing.
            </p>
            <p class="mt-6 flex flex-wrap gap-x-2 text-sm text-muted-foreground">
              <span>By {AUTHOR_NAME}</span>
              <span aria-hidden="true">·</span>
              <span>Published <time datetime={STORY_PUBLISHED}>{formatDate(STORY_PUBLISHED)}</time></span>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={STORY_MODIFIED}>{formatDate(STORY_MODIFIED)}</time></span>
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#collection" class="hero-cta">Read what happened <span aria-hidden="true">↓</span></a>
              <a href="#timeline-heading" class="hero-cta-secondary">See the timeline</a>
            </div>
            <p class="hero-disclosure mt-10">
              Disclosure: this is a customer account of one purchase, including our recollections
              of conversations. The dispute awaits an NCAT hearing. McCarroll's has not yet been
              invited to respond specifically to this article.
            </p>
          </div>

          <aside aria-labelledby="current-status" class="case-card">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 id="current-status" class="section-marker mb-0!">Current status</h2>
              <time datetime={STORY_MODIFIED} class="text-xs text-muted-foreground">
                {formatDate(STORY_MODIFIED)}
              </time>
            </div>
            <p class="mt-3 text-base leading-7 text-foreground">{CURRENT_STATUS}</p>
            <ol class="case-steps mt-7" aria-label="What has happened so far">
              {
                caseSteps.map((step) => (
                  <li class="case-step" data-pending={step.pending ? "" : undefined}>
                    <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                      {step.when}
                    </p>
                    <p class="mt-0.5 font-bold leading-snug text-foreground">{step.title}</p>
                    <p class="mt-0.5 text-sm leading-6 text-muted-foreground">{step.note}</p>
                  </li>
                ))
              }
            </ol>
          </aside>
        </div>
      </header>

      <div class="mx-auto max-w-6xl px-4 sm:px-6">

      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:items-start lg:gap-12">
        <nav aria-label="Table of contents" class="toc-nav sticky top-24 hidden lg:order-2 lg:grid">
          <p class="text-xs font-bold uppercase tracking-wide text-muted-foreground">
            On this page
          </p>
          {toc.map((item) => <a href={item.href} class="toc-link">{item.label}</a>)}
          <a href="#main-content" class="toc-top">Back to top ↑</a>
        </nav>

        <div class="min-w-0 lg:order-1">
          <details class="editorial-details mb-section mt-0! hidden sm:block lg:hidden">
            <summary>On this page</summary>
            <nav aria-label="Table of contents" class="toc-nav mt-4">
              {toc.map((item) => <a href={item.href} class="toc-link">{item.label}</a>)}
              <a href="#main-content" class="toc-top">Back to top ↑</a>
            </nav>
          </details>

          <section aria-labelledby="in-short" class="in-short">
            <h2 id="in-short" class="section-marker">In short</h2>
            <p>
              I collected a brand-new Haval Jolion Vanta from McCarroll's GWM in Artarmon and found
              damage on it the same day. Two repair visits later, the dents and a paint stain were
              fixed, but a scratch above the driver's door handle was not. We were told twice that it
              had been fixed; twice, it hadn't. A sales manager eventually said the door needed
              repainting and that he would not authorise it, before an offer to repaint it only arrived
              once we raised the NSW Civil and Administrative Tribunal. This chronology records what
              happened at each visit, what we were told, and why we haven't accepted the latest offer.
            </p>
          </section>

          <section aria-labelledby="quick-answers" class="quick-answers mt-section">
            <h2 id="quick-answers" class="text-xl font-bold text-foreground">Quick answers</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              The short version, as of {formatDate(STORY_MODIFIED)}.
            </p>
            <Faq items={quickAnswers} />
          </section>

          <section aria-labelledby="collection" class="story-section">
            <p class="section-marker">Collection</p>
            <h2 id="collection" class="text-3xl font-bold text-foreground">Collection day</h2>
            <p>
              I collected my first car, a brand-new 2026 Haval Jolion Vanta, from McCarroll's GWM
              in Artarmon in May 2026. At collection, we found two dents on the rear passenger
              door, a deep scratch above the driver's door handle and a paint stain on the bonnet.
              Protective wrapping was also trapped between a door's rubber seal and frame.
            </p>
            <EvidencePhotos section="collection" />
            <p>
              We reported the problems immediately. What followed was a series of repair visits,
              assurances and changing offers that left us with an unresolved scratch and little
              confidence in another attempt. Before accepting a car this way, I would now use{" "}
              <a href="/faq/#delivery-inspection" class="editorial-link"
                >a written delivery inspection covering condition, not only the paperwork</a
              >.
            </p>
          </section>

          <section aria-labelledby="dents-fixed" class="story-section">
            <p class="section-marker">First repair</p>
            <h2 id="dents-fixed" class="text-3xl font-bold text-foreground">
              The dents were fixed. The scratch wasn't.
            </h2>
            <p>
              The first repair visit took place around June. The dealership kept the car for
              approximately three days and successfully removed the two dents and the bonnet
              stain.
            </p>
            <p><strong>The driver's door scratch remained.</strong></p>
            <p>
              We raised it again and arranged a second visit, approximately two weeks later. The
              car went back for another three days. Before collecting it, we contacted the
              dealership to check that the work was complete. We were assured, once again, that
              the damage had been fixed.
            </p>
          </section>

          <section aria-labelledby="second-collection" class="story-section">
            <p class="section-marker">Second repair</p>
            <h2 id="second-collection" class="text-3xl font-bold text-foreground">
              “Fixed”—until we saw the car
            </h2>
            <div class="editorial-card mt-8">
              <p class="text-xs font-semibold uppercase tracking-wide text-primary">
                At the second collection
              </p>
              <div
                class="mt-3 border border-dashed border-border bg-background p-4 font-mono text-sm leading-relaxed text-foreground"
              >
                Dents: repaired<br />
                Bonnet stain: repaired<br />
                Driver's door scratch: <span class="text-muted-foreground">touch-up applied, damage still visible</span>
              </div>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">
                The scratch still had not been properly repaired. Touch-up paint appeared to have
                been applied, but to us, the finish looked worse than before.
              </p>
            </div>
            <EvidencePhotos section="second-collection" />

            <p class="mt-8">
              A sales manager offered two services, which he valued at approximately
              $400–$500, instead of further repairing the door. We had brought the car back
              to have the damage fixed. An offer of servicing left that problem unresolved (see{" "}
              <a href="/faq/#services-instead" class="editorial-link"
                >what you can do when a dealer offers services instead of a repair</a
              >).
            </p>
            <p>
              The manager then explained that a proper repair would require removing and
              repainting the driver's door. As we recall it, he gave that explanation without
              looking at the damaged area during the conversation. He said words to the effect of
              “I'm not going to paint this,” before walking away.
            </p>
          </section>

          <section aria-labelledby="two-attempts" class="story-section">
            <p class="section-marker">The explanation</p>
            <h2 id="two-attempts" class="text-3xl font-bold text-foreground">
              Why did it take two attempts to explain the repair?
            </h2>
            <p>
              That conversation left us with an obvious question: if the door needed repainting,
              why hadn't that been explained before we were told it was fixed? The dealership had
              arranged repairs, removed the other damage and attempted to touch up the scratch. We
              expected that work to involve assessing what was needed.
            </p>
            <p>
              We do not know when the dealership decided repainting was necessary. But we had not
              been given that explanation before two repair visits and repeated assurances that
              the problem was resolved. Instead, we were learning about the required work at the
              same time we were being told the manager would not authorise it. An honest, clear
              discussion at the outset could have saved considerable time and frustration.
            </p>
          </section>

          <section aria-labelledby="ncat-offer" class="story-section">
            <p class="section-marker">Escalation</p>
            <h2 id="ncat-offer" class="text-3xl font-bold text-foreground">
              After we raised NCAT, the offer changed
            </h2>
            <p>
              We continued pursuing the issue through emails and text messages. After we said we
              intended to take the matter to the{" "}
              <a
                href="https://ncat.nsw.gov.au/case-types/consumers-and-businesses/motor-vehicles.html"
                class="editorial-link"
                rel="noopener">NSW Civil and Administrative Tribunal (NCAT)</a
              >, the
              dealership offered to repaint the driver's door and provide three services. At that
              stage, it also identified a panel shop that we were told had experience with
              European vehicles.
            </p>
            <p>
              This was an offer to carry out further repairs. By then, however, our confidence had
              deteriorated. Twice, we had left the car for repairs. Twice, we had been told the
              issue was fixed. What we saw at collection did not match those assurances. We wanted
              to know why another attempt would deliver a different result — and why this
              repair option had not been clearly presented earlier.
            </p>
          </section>

          <section aria-labelledby="why-declined" class="story-section">
            <p class="section-marker">Our decision</p>
            <h2 id="why-declined" class="text-3xl font-bold text-foreground">
              Why we didn't accept repainting and three services
            </h2>
            <p>
              Our concern extended beyond getting paint onto the door. I had bought a new car that
              arrived with damage. After two unsuccessful attempts to repair the scratch, we no
              longer felt confident in the dealership's handling of the work.
            </p>
            <p>
              We were also concerned about whether the damage and repainting would affect the
              car's resale value. We asked for{" "}
              <a href="/faq/#drop-in-value" class="editorial-link"
                >compensation for that potential loss</a
              >; the amount, if any, remains disputed. The offer of repainting and three services did not resolve
              those concerns, and further correspondence has prolonged the process without
              producing an agreement.
            </p>
          </section>

      <section aria-labelledby="timeline-heading" class="story-section">
        <p class="section-marker">Documented chronology</p>
        <h2 id="timeline-heading" class="mt-3 text-3xl font-bold text-foreground">The timeline</h2>
        <ol class="mt-10 border-t border-border">
          {
            timeline.map((item) => (
              <li
                id={item.id}
                class="grid gap-2 border-b border-border py-6 sm:grid-cols-[16rem_minmax(0,1fr)] sm:gap-8"
              >
                <div>
                  <time
                    class="block text-sm font-semibold text-primary"
                    datetime={item.datetime}
                  >
                    {item.date}
                  </time>
                  <p class="mt-1 text-sm text-muted-foreground">{item.location}</p>
                  <a
                    href={`#${item.id}`}
                    class="mt-2 block font-bold leading-snug text-foreground no-underline hover:text-primary"
                  >
                    {item.title}
                  </a>
                </div>
                <p class="text-muted-foreground">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="dispute-status" class="story-section">
        <p class="section-marker">Where things stand now</p>
        <h2 id="dispute-status" class="text-3xl font-bold text-foreground">
          Where the dispute stands
        </h2>
        <p>At the time of writing:</p>
        <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-primary">
          <li>The driver's door scratch has not been satisfactorily repaired.</li>
          <li>Some protective wrapping remains trapped.</li>
          <li>
            The dealership's latest offer remains repainting the driver's door plus three
            services.
          </li>
          <li>An NCAT hearing is yet to be scheduled.</li>
        </ul>
        <p class="mt-6">
          McCarroll's repaired the dents and bonnet stain. Our complaint concerns the remaining
          scratch, the way the repair process was handled and the difficulty of reaching an
          acceptable resolution. Following every assurance with{" "}
          <a href="/faq/#document-records" class="editorial-link">a same-day written summary</a>
          {" "}is the one change that would have made this record far easier to stand behind.
        </p>
      </section>

      <section aria-labelledby="differently" class="story-section story-section-emphasis">
        <p class="section-marker">What I'd do differently</p>
        <h2 id="differently" class="text-3xl font-bold text-foreground">
          A first car shouldn't start like this
        </h2>
        <p>
          What frustrated us most was the gap between being told the damage was fixed and seeing
          that it wasn't. We wanted the necessary work explained clearly and completed properly.
          Instead, a problem identified on collection day led to two repair visits, repeated
          follow-ups and a dispute that remains unresolved.
        </p>
        <ol class="mt-6 list-decimal space-y-3 pl-5 marker:font-bold marker:text-primary">
          <li>
            <a href="/faq/#delivery-inspection" class="editorial-link"
              >Inspect the car in good light before signing the delivery record</a
            > — photograph every panel, not only the ones you expect to check.
          </li>
          <li>
            <a href="/faq/#repair-scope-writing" class="editorial-link"
              >Ask for the scope of any repair in writing</a
            > before the car goes back a second time, including whether a panel needs repainting
            rather than touching up.
          </li>
          <li>
            <a href="/faq/#document-records" class="editorial-link"
              >Follow every assurance with a dated email or text the same day</a
            >, especially "it's been fixed."
          </li>
          <li>
            <a href="/faq/#escalate-complaint" class="editorial-link"
              >Know when to escalate to your state's consumer tribunal</a
            > if repeated attempts haven't resolved the damage.
          </li>
        </ol>
        <p class="mt-8">
          I wanted to enjoy my first car. I did not expect to spend the months after collection
          pursuing repairs to damage that was there from the start. If the car's value has been
          reduced by the damage and repairs, we believe that is a fair matter for compensation
          alongside having the damage properly repaired, which is now a question for NCAT to
          decide. Those checks, and how to{" "}
          <a href="/faq/#not-as-described" class="editorial-link"
            >understand your rights if a car isn't as described</a
          >, are collected in the{" "}
          <a href="/faq/" class="editorial-link">practical Australian car-buying guide</a>.
        </p>
      </section>

      <section aria-labelledby="fair-outcome" class="story-section">
        <p class="section-marker">Over to you</p>
        <h2 id="fair-outcome" class="text-3xl font-bold text-foreground">
          What do you think is a fair outcome?
        </h2>
        <p>
          We paid for a brand-new car but received one with several areas of damage. Having those
          repaired is one part of the solution. Our concern is whether the damage and repairs
          could also leave the car worth less.
        </p>
        <p>
          If the car's value has been reduced, would it be fair to receive compensation for that
          loss as well as having the damage properly repaired?
        </p>
        <p>
          Have you faced something similar? If you share your own experience somewhere public,
          such as a review site or forum, please keep to what happened to you and, as with this
          account, avoid naming individual employees.
        </p>
      </section>
        </div>
      </div>
      </div>
    </article>

    <nav aria-label="Continue reading" class="onward-links">
      <p class="eyebrow">Continue reading</p>
      <div class="mt-5 flex flex-col items-start gap-4">
        <a href="/faq/#delivery-inspection" class="editorial-link"
          >Check what to inspect before you accept a new car</a
        >
        <a href="/faq/#escalate-complaint" class="editorial-link"
          >Follow the steps for escalating a dealer complaint</a
        >
        <a href="/blog/mccarrolls-gwm-artarmon-dealership-assessment/" class="editorial-link"
          >Read the stage-by-stage McCarroll's GWM Artarmon dealership assessment</a
        >
        <a href="/blog/" class="editorial-link"
          >Read my Haval Jolion owner reviews</a
        >
      </div>
    </nav>
  </main>

  <script>
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-nav a.toc-link");
    const sections = Array.from(
      new Set(
        Array.from(navLinks)
          .map((link) => document.getElementById((link.getAttribute("href") ?? "").slice(1)))
          .filter((el): el is HTMLElement => el !== null),
      ),
    );

    if (sections.length && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        navLinks.forEach((link) => {
          link.classList.toggle("toc-active", link.getAttribute("href") === `#${id}`);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: "-15% 0px -70% 0px", threshold: 0 },
      );

      sections.forEach((section) => observer.observe(section));
    }
  </script>
</BaseLayout>
