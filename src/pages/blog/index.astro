---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { REVIEW_CATEGORIES, categorySlug } from "../../lib/categories";
import { SITE_URL, ids, pageTitle } from "../../lib/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

// Lower-cased text each card is matched against by the hero search box.
const searchText = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.topic, post.data.category, ...post.data.tags]
    .join(" ")
    .toLowerCase();

// Only offer filter chips for categories that have at least one post.


const title = "McCarroll's GWM Artarmon & Haval Jolion Owner Reviews";
const description =
  "My owner reviews of the 2026 GWM Haval Jolion Vanta and a stage-by-stage assessment of McCarroll's GWM Artarmon, from one purchase in Sydney.";
const pageUrl = `${SITE_URL}/blog/`;
const schema = [
  {
    "@type": "CollectionPage",
    "@id": `${pageUrl}#page`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "en-AU",
    isPartOf: { "@id": ids.website },
    author: { "@id": ids.author },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${SITE_URL}/blog/${post.id}/`,
        name: post.data.title,
      })),
    },
  },
];
---

<BaseLayout
  title={pageTitle(title)}
  description={description}
  schema={schema}
>
  <main id="main-content">
    <article>
      <header class="hero-band">
        <div class="pb-section mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-14 lg:pt-20">
          <div>
            <p class="hero-kicker">
              Owner reviews · {posts.length} {posts.length === 1 ? "article" : "articles"}
            </p>
            <h1 class="hero-title mt-6">
              McCarroll's GWM Artarmon and the Haval Jolion, reviewed separately
            </h1>
            <p class="hero-hook mt-6 max-w-none!">
              I bought a new 2026 GWM Haval Jolion Vanta from McCarroll's GWM Artarmon in May 2026.
              Everything here comes from that purchase and from driving the car around Sydney since.
            </p>
            <p class="hero-disclosure mt-8 max-w-none!">
              The dealership and the car are reviewed separately: how McCarroll's handled delivery,
              repairs and my complaint says nothing about how the Jolion drives, and the other way
              round. I am not affiliated with McCarroll's or GWM and the site carries no advertising.
            </p>
          </div>
        <form role="search" class="mt-10 w-full sm:w-1/2" action="/blog/" method="get">
          <label for="review-search" class="sr-only">Search reviews</label>
          <input
            id="review-search"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Search reviews, e.g. safety, price, dealership"
            class="h-12 w-full rounded-[var(--radius)] border border-input bg-background px-4 text-base text-foreground placeholder:text-muted-foreground focus:border-foreground focus:outline-none focus-visible:outline-none"
          />
        </form>
        <div role="group" aria-label="Filter by category" class="mt-4 flex flex-wrap gap-2">
          {
            [
              { slug: "", label: "All" },
              ...REVIEW_CATEGORIES.map((c) => ({ slug: categorySlug(c), label: c })),
            ].map(({ slug, label }) => (
              <button
                type="button"
                data-category-filter={slug}
                aria-pressed={slug === "" ? "true" : "false"}
                class="h-9 cursor-pointer rounded-full border border-border bg-background px-3.5 text-sm font-medium text-muted-foreground hover:border-foreground hover:text-foreground aria-pressed:border-foreground aria-pressed:bg-foreground aria-pressed:text-background"
              >
                {label}
              </button>
            ))
          }
        </div>
        <p id="review-search-status" class="sr-only" aria-live="polite"></p>
        </div>
      </header>

      <div class="mx-auto max-w-6xl px-4 sm:px-6">

      {
        posts.length > 0 ? (
          <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <div
                data-review-card
                data-search={searchText(post)}
                data-category={categorySlug(post.data.category)}
                class="grid"
              >
                <PostCard post={post} headingLevel="h2" />
              </div>
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground">
            The first reviews are on their way — check back soon.
          </p>
        )
      }
      <!-- Shown when a chip or search matches nothing. The heading and message
           are left empty here and filled in by the script, so crawlers never
           read a "no reviews" heading on a page that has reviews. -->
      <div id="review-search-empty" class="empty-state" hidden>
        <svg
          aria-hidden="true"
          class="size-10 text-muted-foreground"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path
            d="M14 2v6h6"></path><path d="M9 15h6"></path></svg
        >
        <p data-empty-title class="mt-5 text-xl font-bold text-foreground"></p>
        <p data-empty-message class="mx-auto mt-2 max-w-[46ch] leading-7 text-muted-foreground"></p>
        <button type="button" data-empty-reset class="hero-cta-secondary mt-7 cursor-pointer">
          Show all reviews
        </button>
      </div>
      </div>
    </article>

    <nav aria-label="Continue reading" class="onward-links">
      <p class="eyebrow">Continue reading</p>
      <div class="mt-5 flex flex-col items-start gap-4">
        <a href="/" class="editorial-link"
          >Follow the purchase from order to unresolved complaint</a
        >
        <a href="/faq/" class="editorial-link">Use the pre-deposit and delivery checklists</a>
      </div>
    </nav>
  </main>

  <script>
    const input = document.querySelector<HTMLInputElement>("#review-search");
    const status = document.querySelector<HTMLElement>("#review-search-status");
    const empty = document.querySelector<HTMLElement>("#review-search-empty");
    const emptyTitle = empty?.querySelector<HTMLElement>("[data-empty-title]");
    const emptyMessage = empty?.querySelector<HTMLElement>("[data-empty-message]");
    const emptyReset = empty?.querySelector<HTMLButtonElement>("[data-empty-reset]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-review-card]")];
    const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];

    const params = new URLSearchParams(window.location.search);
    let category = params.get("category") ?? "";
    if (!chips.some((chip) => chip.dataset.categoryFilter === category)) category = "";

    // A card shows when it is in the selected category (if any) and every word
    // typed appears somewhere in its title, description, topic, category or
    // tags. Both are mirrored to ?q= and ?category= so filtered views can
    // be shared. When nothing matches, the empty state explains why.
    function applyFilters() {
      const query = input?.value ?? "";
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? "";
        const match =
          (!category || card.dataset.category === category) &&
          terms.every((term) => text.includes(term));
        card.hidden = !match;
        if (match) visible++;
      }
      for (const chip of chips) {
        chip.setAttribute("aria-pressed", String(chip.dataset.categoryFilter === category));
      }
      const filtered = terms.length > 0 || category !== "";
      if (status) status.textContent = filtered ? `${visible} of ${cards.length} match` : "";
      if (empty) empty.hidden = visible > 0 || cards.length === 0;
      if (visible === 0 && emptyTitle && emptyMessage) {
        const label = chips.find((chip) => chip.dataset.categoryFilter === category)?.textContent?.trim();
        if (terms.length > 0) {
          emptyTitle.textContent = `No reviews match “${query.trim()}”${category ? ` in ${label}` : ""}`;
          emptyMessage.textContent =
            "Try a broader term, such as “Jolion”, “price” or “dealership”, or show all reviews.";
        } else {
          emptyTitle.textContent = `No ${label} reviews yet`;
          emptyMessage.textContent =
            "Everything here comes from my own car and my own purchase, so this topic will be added once I have something first-hand to share.";
        }
      }

      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set("q", query.trim());
      else url.searchParams.delete("q");
      if (category) url.searchParams.set("category", category);
      else url.searchParams.delete("category");
      history.replaceState(null, "", url);
    }

    emptyReset?.addEventListener("click", () => {
      category = "";
      if (input) input.value = "";
      applyFilters();
    });

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        category = chip.dataset.categoryFilter ?? "";
        applyFilters();
      });
    }

    if (input) {
      input.value = params.get("q") ?? "";
      input.addEventListener("input", applyFilters);
      input.form?.addEventListener("submit", (event) => {
        event.preventDefault();
        applyFilters();
      });
    }
    applyFilters();
  </script>
</BaseLayout>
