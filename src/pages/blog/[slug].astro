---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import PrevNextNav from "../../components/blog/PrevNextNav.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.topicNumber - b.data.topicNumber,
  );

  return posts.map((post, index) => {
    const sharedTagCount = (candidate: CollectionEntry<"blog">) =>
      candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length;

    const related = posts
      .filter((candidate) => candidate.id !== post.id)
      .sort((a, b) => sharedTagCount(b) - sharedTagCount(a) || a.data.topicNumber - b.data.topicNumber)
      .slice(0, 3);

    return {
      params: { slug: post.id },
      props: {
        post,
        prev: posts[index - 1] ?? null,
        next: posts[index + 1] ?? null,
        related,
      },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, topic, heroImage, heroImageAlt, publishDate, updatedDate } = post.data;

const formattedDate = new Intl.DateTimeFormat("en-AU", { dateStyle: "long" }).format(publishDate);
const wordCount = post.body?.trim().split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout
  title={`${title} | GWM Haval Jolion Review`}
  description={description}
  ogType="article"
  image={heroImage}
  publishedTime={publishDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
>
  <main id="main-content">
    <article class="mx-auto max-w-6xl px-4 pb-8 pt-16 sm:px-6 sm:pt-24">
      <header class="max-w-reading">
        <p class="eyebrow">
          <a href="/blog/" class="text-inherit no-underline hover:underline">GWM Haval Jolion review</a>
          <span aria-hidden="true"> · </span>{topic}
        </p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-foreground sm:text-5xl">{title}</h1>
        <p class="mt-6 text-xl leading-8 text-muted-foreground">{description}</p>
        <p class="mt-5 text-sm text-muted-foreground">
          <time datetime={publishDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true"> · </span>{readMinutes} min read
        </p>
      </header>

      {
        heroImage ? (
          <img
            src={heroImage}
            alt={heroImageAlt ?? ""}
            class="mt-10 w-full border border-border"
          />
        ) : (
          <div class="exhibit-photo mt-10">
            <span class="font-mono text-xs leading-relaxed tracking-wide text-muted-foreground">
              PHOTO — to be added
            </span>
          </div>
        )
      }

      <div class="mt-14 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-12">
        <div class="min-w-0">
          <TableOfContents headings={headings} variant="mobile" />
          <div class="blog-prose max-w-reading mt-10 lg:mt-0">
            <Content />
          </div>
        </div>
        <TableOfContents headings={headings} variant="desktop" />
      </div>

      <PrevNextNav prev={prev} next={next} />
      <RelatedPosts posts={related} />
    </article>
  </main>
</BaseLayout>
